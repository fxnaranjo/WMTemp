interface Temperature

service celsiusToFahrenheit (
    input {
        Double celsius;
    }
    output {}
) {
    TRY {
        // Step 1: celsius × 9
        INVOKE pub.math:multiplyFloats {
            comment: "Multiply celsius by 9"
            input {
                mapSource {
                    Double celsius;
                }
                mapTarget {
                    String num1;
                    String num2;
                }
                copy celsius -> num1;
                set num2 = "9";
            }
            output {
                mapSource {
                    String `value`;
                }
                mapTarget {
                    String step1Result;
                }
                copy `value` -> step1Result;
                drop `value`;
            }
        }
        // Step 2: (celsius × 9) ÷ 5
        INVOKE pub.math:divideFloats {
            comment: "Divide step 1 result by 5"
            input {
                mapSource {
                    String step1Result;
                }
                mapTarget {
                    String num1;
                    String num2;
                }
                copy step1Result -> num1;
                set num2 = "5";
                drop step1Result;
            }
            output {
                mapSource {
                    String `value`;
                }
                mapTarget {
                    String step2Result;
                }
                copy `value` -> step2Result;
                drop `value`;
            }
        }
        // Step 3: (celsius × 9 ÷ 5) + 32
        INVOKE pub.math:addFloats {
            comment: "Add 32 to step 2 result to produce fahrenheit"
            input {
                mapSource {
                    String step2Result;
                }
                mapTarget {
                    String num1;
                    String num2;
                }
                copy step2Result -> num1;
                set num2 = "32";
                drop step2Result;
            }
            output {
                mapSource {
                    String `value`;
                }
                mapTarget {
                    Double fahrenheit;
                }
                copy `value` -> fahrenheit;
                drop `value`;
            }
        }
        // Step 4: Assemble response document and serialise to JSON
        MAP {
            comment: "Assemble celsius and fahrenheit into a response document"
            mapSource {
                Double celsius;
                Double fahrenheit;
            }
            mapTarget {
                record response {
                    Double celsius;
                    Double fahrenheit;
                };
            }
            copy celsius -> response/celsius;
            copy fahrenheit -> response/fahrenheit;
        }
        INVOKE pub.json:documentToJSON {
            comment: "Serialise response document to JSON string"
            input {
                mapSource {
                    record response {
                        Double celsius;
                        Double fahrenheit;
                    };
                }
                mapTarget {
                    record `document` {
                        Double celsius;
                        Double fahrenheit;
                    };
                    String loadAs;
                }
                copy response/celsius -> `document`/celsius;
                copy response/fahrenheit -> `document`/fahrenheit;
                set loadAs = "string";
                drop response;
            }
            output {
                mapSource {
                    Object jsonObj;
                }
                mapTarget {
                    Object jsonObj;
                }
                copy jsonObj -> jsonObj;
            }
        }
        // Step 5: Return raw JSON with application/json Content-Type
        INVOKE pub.flow:setHTTPResponse {
            comment: "Write JSON string directly to HTTP response body"
            input {
                mapSource {
                    Object jsonObj;
                }
                mapTarget {
                    record httpResponse {
                        String responseString;
                        String contentType;
                    };
                }
                copy jsonObj -> httpResponse/responseString;
                set httpResponse/contentType = "application/json";
                drop jsonObj;
            }
        }
    }
    CATCH {
        INVOKE pub.flow:getLastError {
            output {
                mapSource {
                    record lastError {
                        String error;
                    };
                }
                mapTarget {
                    String errorMessage;
                }
                copy lastError/error -> errorMessage;
            }
        }
        EXIT {
            exitFrom: "$flow"
            signal: "FAILURE"
            failureMessage: "celsiusToFahrenheit failed: %errorMessage%"
        }
    }
}